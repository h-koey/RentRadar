<+>\r\n{% extends \"base.html\" %}\r\n\r\n{% block title %}{{ apartment.name }} | Illini Rent Radar{% endblock %}\r\n\r\n{% block content %}\r\n\r\n<h2>{{ apartment.name }}</h2>\r\n\r\n<h3>Apartment Information</h3>\r\n<p>Address: {{ apartment.street_address }}</p>\r\n<p>City: {{ apartment.city }}</p>\r\n<p>Location: {{ apartment.location }}</p>\r\n\r\n<hr>\r\n\r\n<h3>Lease History</h3>\r\n\r\n{% for lease in lease_records %}\r\n    <div>\r\n        <h4>Unit {{ lease.unit_number }}</h4>\r\n        <p>Lease Year: {{ lease.lease_year }}</p>\r\n        <p>Bedrooms: {{ lease.bedrooms }}</p>\r\n        <p>Bathrooms: {{ lease.bathrooms }}</p>\r\n        <p>Monthly Rent: ${{ lease.monthly_rent }}</p>\r\n        <p>Lease Term: {{ lease.lease_term_months }} months</p>\r\n\r\n        <h4>Additional Costs</h4>\r\n\r\n        {% for cost in lease.costs.all %}\r\n            <p>\r\n                {{ cost.name }}: ${{ cost.amount }}\r\n                ({{ cost.frequency }})\r\n            </p>\r\n        {% empty %}\r\n            <p>No additional costs listed.</p>\r\n        {% endfor %}\r\n    </div>\r\n\r\n    <hr>\r\n\r\n{% empty %}\r\n    <p>No lease records available.</p>\r\n{% endfor %}\r\n\r\n<h3>Rent Predictions</h3>\r\n\r\n{% for prediction in predictions %}\r\n    <p>Year: {{ prediction.target_year }}</p>\r\n    <p>Estimated Monthly Rent: ${{ prediction.estimated_monthly_rent }}</p>\r\n    <p>Estimated Monthly Utilities: ${{ prediction.estimated_monthly_utilities|default:\"Not available\" }}</p>\r\n    <hr>\r\n{% empty %}\r\n    <p>No rent predictions available.</p>\r\n{% endfor %}\r\n\r\n{% endblock %}\r\n
===================================================================
